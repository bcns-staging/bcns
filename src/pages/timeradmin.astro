---
import "../styles/seven-segment-clock.css";
// LoginPanel (reused from the file explorer's admin login) is styled by
// this stylesheet -- not the file explorer's own page-height/grid layout
// rules, just the shared .file-explorer-admin-login/input/button styles.
// Deliberately not wrapped in .file-explorer-theme (that swaps in a
// teal-accented palette specific to /fm) -- this page inherits the site's
// normal default theme instead, which fits better outside the file
// explorer.
import "../styles/file-explorer.css";
import Layout from "../layouts/Layout.astro";
import TimerAdmin from "../components/islands/TimerAdmin.tsx";
---

<style>
  /* Full-bleed "KeyVault" HUD dashboard -- no site header/footer chrome on
     this page at all, per the reference design. --hud-* tokens come from
     seven-segment-clock.css's :root block, imported above.

     The gradient goes on :global(body), not just main -- body is the
     actual full-height, full-bleed element (Layout.astro's, not this
     page's own template, hence :global), so there's no seam of the site's
     default dark-blue background showing past main's own box in any
     scenario (overscroll, a shorter-than-viewport content flash, etc). */
  :global(body) {
    background: var(--hud-gradient);
  }

  main {
    display: block;
    min-height: 100vh;
    padding-block: 2.5rem;
  }

  :global(.timer-admin-login-wrap) {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: calc(100vh - 5rem);
  }

  :global(.timer-admin) {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    width: 100%;
  }

  /* Matches the reference design's "+ DEPLOY NEW TIMER" button -- a lone,
     centered, dashed-border pill below the grid rather than a toolbar
     above it. */
  :global(.timer-admin-add) {
    align-self: center;
    padding: 0.85rem 1.75rem;
    border: 1px dashed var(--hud-border-hover);
    background: transparent;
    color: var(--hud-text-muted);
    font-family: var(--hud-mono);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-size: 0.75rem;
    cursor: pointer;
  }

  :global(.timer-admin-add:hover) {
    border-color: var(--hud-text-muted);
    color: var(--hud-text);
  }

  :global(.timer-admin-form-panel) {
    align-self: center;
    width: 100%;
    max-width: 32rem;
    border: 1px solid var(--hud-border);
    background: var(--hud-panel-bg);
  }

  :global(.timer-admin-form-panel-header) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.85rem 1.1rem;
    border-bottom: 1px solid var(--hud-border);
  }

  :global(.timer-admin-form-panel-title) {
    font-family: var(--hud-mono);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--hud-text-dim);
  }

  :global(.timer-admin-form-close) {
    border: 1px solid var(--hud-border-hover);
    background: transparent;
    color: var(--hud-text-muted);
    width: 1.6rem;
    height: 1.6rem;
    line-height: 1;
    font-size: 1.1rem;
    cursor: pointer;
  }

  :global(.timer-admin-form-close:hover) {
    color: var(--hud-text);
    border-color: var(--hud-text-muted);
  }

  :global(.timer-admin-form) {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.25rem;
  }

  :global(.timer-admin-form input),
  :global(.timer-admin-form textarea) {
    display: block;
    width: 100%;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--hud-border);
    background: rgb(0 0 0 / 30%);
    color: var(--hud-text);
    font-family: var(--hud-mono);
    font-size: 0.85rem;
  }

  :global(.timer-admin-form input::placeholder),
  :global(.timer-admin-form textarea::placeholder) {
    color: var(--hud-text-dimmer);
  }

  :global(.timer-admin-form input:focus),
  :global(.timer-admin-form textarea:focus) {
    outline: none;
    border-color: var(--hud-border-hover);
  }

  :global(.timer-admin-form textarea) {
    resize: vertical;
  }

  :global(.timer-admin-form-actions) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  :global(.timer-admin-form-actions button) {
    padding: 0.5rem 1.25rem;
    font-family: var(--hud-mono);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    cursor: pointer;
    white-space: nowrap;
  }

  :global(.timer-admin-form-actions button[type="submit"]) {
    border: 1px solid var(--hud-accent);
    background: rgb(255 60 30 / 12%);
    color: var(--hud-accent);
  }

  :global(.timer-admin-form-actions button[type="submit"]:hover) {
    background: rgb(255 60 30 / 22%);
  }

  :global(.timer-admin-pause) {
    border: 1px solid var(--hud-border-hover);
    background: transparent;
    color: var(--hud-text-muted);
  }

  :global(.timer-admin-pause:hover) {
    color: var(--hud-text);
    border-color: var(--hud-text-muted);
  }

  :global(.timer-admin-delete) {
    border: 1px solid var(--hud-accent);
    background: transparent;
    color: var(--hud-accent);
  }

  :global(.timer-admin-cancel) {
    border: 1px solid var(--hud-border-hover);
    background: transparent;
    color: var(--hud-text-dim);
  }

  :global(.timer-admin-form-actions button:disabled) {
    opacity: 0.6;
    cursor: not-allowed;
  }

  :global(.timer-admin-error) {
    color: var(--hud-accent);
    font-size: 0.85rem;
  }

  /* Login gate -- reuses the file explorer's shared LoginPanel component
     (see file-explorer.css's .file-explorer-admin-login* rules), scoped
     overrides here so it matches the HUD theme on this page specifically
     without touching those shared rules (which /fm/admin also relies on,
     with its own teal palette). */
  :global(.timer-admin-login-wrap .file-explorer-admin-login) {
    border: 1px solid var(--hud-border);
    border-radius: 0;
    background: var(--hud-panel-bg);
    padding: 1.25rem;
    min-width: 20rem;
  }

  :global(.timer-admin-login-wrap .file-explorer-admin-login input) {
    border: 1px solid var(--hud-border);
    border-radius: 0;
    background: rgb(0 0 0 / 30%);
    color: var(--hud-text);
    font-family: var(--hud-mono);
  }

  :global(.timer-admin-login-wrap .file-explorer-admin-login input:focus) {
    outline: none;
    border-color: var(--hud-border-hover);
  }

  :global(.timer-admin-login-wrap .file-explorer-icon-button) {
    border: 1px solid var(--hud-accent);
    border-radius: 0;
    background: rgb(255 60 30 / 12%);
    color: var(--hud-accent);
    font-family: var(--hud-mono);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  :global(.timer-admin-login-wrap .file-explorer-icon-button:hover) {
    background: rgb(255 60 30 / 22%);
    border-color: var(--hud-accent);
    color: var(--hud-accent);
  }

  :global(.timer-admin-login-wrap .file-explorer-link-button) {
    color: var(--hud-text-dim);
    font-family: var(--hud-mono);
  }

  :global(.timer-admin-login-wrap .file-explorer-link-button:hover) {
    color: var(--hud-text);
  }

  :global(.timer-admin-login-wrap .file-explorer-admin-login-hint) {
    color: var(--hud-text-dim);
    font-family: var(--hud-mono);
  }

  :global(.timer-admin-login-wrap .file-explorer-error),
  :global(.timer-admin-login-wrap .file-explorer-admin-login-error) {
    color: var(--hud-accent);
    font-family: var(--hud-mono);
  }
</style>

<Layout title="Timer Admin | 7 Beacons">
  <main>
    <div class="container">
      <TimerAdmin client:load />
    </div>
  </main>
</Layout>
