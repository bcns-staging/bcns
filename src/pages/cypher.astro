---
import "../styles/seven-segment-clock.css";
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Clock from "../components/islands/Clock.tsx";
---

<style>
  section {
    padding-block: 3rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2rem;
  }
</style>

<Layout title="Cypher | 7 Beacons">
  <Header />
  <main>
    <section class="container">
      {/* "timerclock" -- referred to by this name in later requests. */}
      <Clock client:load />
    </section>
  </main>
  <Footer />
</Layout>
