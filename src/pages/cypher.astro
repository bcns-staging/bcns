---
import "../styles/seven-segment-clock.css";
import Layout from "../layouts/Layout.astro";
import TimerList from "../components/islands/TimerList.tsx";
---

<style>
  /* Full-bleed "KeyVault" HUD dashboard -- no site header/footer chrome on
     this page at all, per the reference design. --hud-* tokens come from
     seven-segment-clock.css's :root block, imported above.

     The gradient goes on :global(body), not just main -- body is the
     actual full-height, full-bleed element (Layout.astro's, not this
     page's own template, hence :global), so there's no seam of the site's
     default dark-blue background showing past main's own box in any
     scenario (overscroll, a shorter-than-viewport content flash, etc). */
  :global(body) {
    background: var(--hud-gradient);
  }

  main {
    display: block;
    min-height: 100vh;
    padding-block: 2.5rem;
  }
</style>

<Layout title="Cypher | 7 Beacons">
  <main>
    <div class="container">
      {/* Public mirror of whatever's managed in /admin's Timer Admin tab --
          same /api/timers data, polled independently; see TimerList.tsx. */}
      <TimerList client:load />
    </div>
  </main>
</Layout>
