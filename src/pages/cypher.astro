---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Clock from "../components/islands/Clock.tsx";
---

<style>
  section {
    padding-block: 3rem;
    display: flex;
    justify-content: center;
  }

  /* Everything below targets Clock.tsx's rendered output -- Astro's <style>
     scoping only rewrites markup this file renders directly, not a
     framework island's own render tree, so :global() is required to reach
     it. Kept page-local (not in the shared file-explorer.css style) since
     nothing else on the site uses this look yet. */

  :global(.digital-clock) {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    background: #000;
    padding: 2.5rem 3rem;
    border-radius: 1rem;
    border: 1px solid #1a1a1a;
  }

  :global(.clock-row) {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
  }

  :global(.clock-date-row) {
    transform: scale(0.6);
    transform-origin: center;
    margin-top: -0.5rem;
  }

  :global(.clock-box) {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    background: #0a0a0a;
    border: 2px solid #1c1c1c;
    border-radius: 10px;
    padding: 14px 12px;
  }

  :global(.clock-colon) {
    display: inline-flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 10px;
    height: 78px;
    margin: 0 0.4rem;
  }

  :global(.clock-colon-dot) {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    /* Unlit by default, same dark-red "off segment" look as .segment --
       the time row's colons toggle .is-lit on/off once a second (see
       Clock.tsx), the date row's stay lit via the same class. */
    background: #2a0808;
    transition: background-color 0.15s ease, box-shadow 0.15s ease;
  }

  :global(.clock-colon-dot.is-lit) {
    background: #ff1a1a;
    box-shadow:
      0 0 8px 2px rgba(255, 26, 26, 0.85),
      0 0 16px 4px rgba(255, 26, 26, 0.35);
  }

  :global(.digit) {
    position: relative;
    display: inline-block;
    /* Thin-segment proportions matched to the reference photo: a tall,
       narrow digit (width:height roughly 1:2) with a segment thickness
       that's a much smaller fraction of the digit box than a typical
       bold LED-clock rendering. */
    width: 38px;
    height: 78px;
    margin: 0 2px;
    /* The italic-leaning LED look -- skews the whole digit as one unit, so
       its 7 child segments (each individually positioned/clipped) tilt
       together rather than needing their own per-segment transforms. */
    transform: skewX(-8deg);
  }

  :global(.segment) {
    position: absolute;
    background: #2a0808;
    transition: background-color 0.15s ease, box-shadow 0.15s ease;
  }

  :global(.segment.is-lit) {
    background: #ff1a1a;
    box-shadow:
      0 0 8px 2px rgba(255, 26, 26, 0.85),
      0 0 18px 5px rgba(255, 26, 26, 0.4);
  }

  /* Horizontal segments (top / middle / bottom) -- a pointed hexagon bar,
     the classic LED-segment shape. */
  :global(.seg-a),
  :global(.seg-g),
  :global(.seg-d) {
    left: 3px;
    right: 3px;
    height: 7px;
    clip-path: polygon(15% 0%, 85% 0%, 100% 50%, 85% 100%, 15% 100%, 0% 50%);
  }
  :global(.seg-a) {
    top: 0;
  }
  :global(.seg-g) {
    top: 36px;
  }
  :global(.seg-d) {
    bottom: 0;
  }

  /* Vertical segments (the four corner arms) -- same pointed-hexagon idea,
     rotated 90deg via the polygon's own point layout instead of a CSS
     transform, so the box's own width/height stay the arm's real footprint. */
  :global(.seg-f),
  :global(.seg-b),
  :global(.seg-e),
  :global(.seg-c) {
    width: 7px;
    clip-path: polygon(0% 15%, 50% 0%, 100% 15%, 100% 85%, 50% 100%, 0% 85%);
  }
  :global(.seg-f) {
    top: 4px;
    left: 0;
    height: 32px;
  }
  :global(.seg-b) {
    top: 4px;
    right: 0;
    height: 32px;
  }
  :global(.seg-e) {
    bottom: 4px;
    left: 0;
    height: 31px;
  }
  :global(.seg-c) {
    bottom: 4px;
    right: 0;
    height: 31px;
  }

  @media (max-width: 30rem) {
    :global(.digital-clock) {
      padding: 1.5rem 1rem;
      transform: scale(0.75);
    }
  }
</style>

<Layout title="Cypher | 7 Beacons">
  <Header />
  <main>
    <section class="container">
      <Clock client:load />
      <Clock client:load showDate={false} />
    </section>
  </main>
  <Footer />
</Layout>
