---
import "../styles/seven-segment-clock.css";
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Clock from "../components/islands/Clock.tsx";
import TimerList from "../components/islands/TimerList.tsx";
---

<style>
  section {
    padding-block: 3rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2rem;
  }

  :global(.timer-list-public) {
    width: 100%;
    max-width: 48rem;
    border-top: none;
    padding-top: 0;
  }
</style>

<Layout title="Cypher | 7 Beacons">
  <Header />
  <main>
    <section class="container">
      {/* "timerclock" -- referred to by this name in later requests. */}
      <Clock client:load />
      {/* Public mirror of whatever's managed in /timeradmin -- same
          /api/timers data, polled independently; see TimerList.tsx. */}
      <TimerList client:load />
    </section>
  </main>
  <Footer />
</Layout>
