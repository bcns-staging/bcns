---
import "../styles/seven-segment-clock.css";
// LoginPanel (reused from the file explorer's admin login) is styled by
// this stylesheet -- not the file explorer's own page-height/grid layout
// rules, just the shared .file-explorer-admin-login/input/button styles.
// Also carries the File Manager tab's own theme (.file-explorer-theme and
// everything under it).
import "../styles/file-explorer.css";
import Layout from "../layouts/Layout.astro";
import AdminConsole from "../components/islands/AdminConsole.tsx";
---

<style>
  /* Full-bleed "KeyVault" HUD dashboard -- one page, one login, three
     switchable tabs (File Manager / Timer Admin / Dead Drop), replacing
     the three separate admin pages this site used to have. --hud-* tokens
     come from seven-segment-clock.css's :root block, imported above. */
  :global(body) {
    background: var(--hud-gradient);
  }

  main {
    display: block;
    min-height: 100vh;
    padding-block: 2.5rem;
  }

  :global(.admin-tabs) {
    display: flex;
    margin-bottom: 1.5rem;
  }

  :global(.admin-tabs button) {
    flex: 1;
    padding: 0.85rem 1.25rem;
    border: 1px solid var(--hud-border);
    background: var(--hud-panel-bg);
    color: var(--hud-text-muted);
    font-family: var(--hud-mono);
    font-weight: 700;
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    cursor: pointer;
  }

  :global(.admin-tabs button + button) {
    border-left: 0;
  }

  :global(.admin-tabs button:hover:not(.is-active)) {
    color: var(--hud-text);
    border-color: var(--hud-border-hover);
  }

  :global(.admin-tabs button.is-active) {
    background: var(--hud-bg-2);
    color: var(--hud-text);
    border-color: var(--hud-accent);
    box-shadow: inset 0 -2px 0 var(--hud-accent);
  }

  /* File Manager tab: .file-explorer-theme normally fills the whole
     viewport (height: 100dvh, its own internal scroll region) for its
     standalone use on /fm -- inside a tab panel that already has the tab
     bar above it, that would badly overflow. Scoped to .admin-tab-panel
     only, so /fm's own page is untouched. */
  :global(.admin-tab-panel .file-explorer-theme) {
    height: auto;
    min-height: 32rem;
    overflow: visible;
  }

  :global(.admin-settings) {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    padding: 2rem;
    max-width: 32rem;
  }

  :global(.admin-settings-section) {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.85rem;
  }

  :global(.admin-settings-heading) {
    margin: 0;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--color-border);
    width: 100%;
    font-family: var(--file-explorer-mono);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  :global(.timer-admin-login-wrap) {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: calc(100vh - 5rem);
  }

  :global(.timer-admin) {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    width: 100%;
  }

  :global(.timer-admin-add) {
    align-self: center;
    padding: 0.85rem 1.75rem;
    border: 1px dashed var(--hud-border-hover);
    background: transparent;
    color: var(--hud-text-muted);
    font-family: var(--hud-mono);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-size: 0.75rem;
    cursor: pointer;
  }

  :global(.timer-admin-add:hover) {
    border-color: var(--hud-text-muted);
    color: var(--hud-text);
  }

  :global(.deaddrop-revoke) {
    align-self: center;
    margin-top: 0.2rem;
  }

  :global(.deaddrop-pin-tools) {
    display: flex;
    gap: 1.25rem;
    margin-top: -0.35rem;
  }

  /* "Drop sealed -- copy this link now" panel, shown exactly once right
     after creation. Green/"ready" toned, not the neutral form-panel style --
     this is a success state, and the warning is the whole point of it. */
  :global(.deaddrop-created-panel) {
    align-self: center;
    width: 100%;
    max-width: 32rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.25rem;
    border: 1px solid var(--hud-ready-border);
    background: var(--hud-ready-bg);
  }

  :global(.deaddrop-created-title) {
    margin: 0;
    font-family: var(--hud-mono);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--hud-ready);
  }

  :global(.deaddrop-created-warning) {
    margin: 0;
    font-size: 0.8rem;
    color: var(--hud-text-muted);
    line-height: 1.5;
  }

  :global(.deaddrop-created-link-row) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
  }

  :global(.deaddrop-created-link) {
    flex: 1;
    min-width: 12rem;
    padding: 0.5rem 0.7rem;
    background: rgb(0 0 0 / 30%);
    border: 1px solid var(--hud-border);
    font-family: var(--hud-mono);
    font-size: 0.75rem;
    color: var(--hud-text);
    word-break: break-all;
  }

  :global(.deaddrop-created-link-row .timer-reveal-button) {
    width: auto;
    white-space: nowrap;
    padding-inline: 1.25rem;
  }

  :global(.deaddrop-created-pin) {
    margin: 0;
    font-size: 0.85rem;
    color: var(--hud-text);
  }

  :global(.deaddrop-created-pin code) {
    padding: 0.15rem 0.5rem;
    background: rgb(0 0 0 / 30%);
    border: 1px solid var(--hud-border);
    color: var(--hud-ready);
    font-family: var(--hud-mono);
    letter-spacing: 0.1em;
  }

  :global(.deaddrop-created-done) {
    align-self: flex-start;
    padding: 0.5rem 1.25rem;
    font-family: var(--hud-mono);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    cursor: pointer;
  }

  :global(.timer-admin-form-panel) {
    align-self: center;
    width: 100%;
    max-width: 32rem;
    border: 1px solid var(--hud-border);
    background: var(--hud-panel-bg);
  }

  :global(.timer-admin-form-panel-header) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.85rem 1.1rem;
    border-bottom: 1px solid var(--hud-border);
  }

  :global(.timer-admin-form-panel-title) {
    font-family: var(--hud-mono);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--hud-text-dim);
  }

  :global(.timer-admin-form-close) {
    border: 1px solid var(--hud-border-hover);
    background: transparent;
    color: var(--hud-text-muted);
    width: 1.6rem;
    height: 1.6rem;
    line-height: 1;
    font-size: 1.1rem;
    cursor: pointer;
  }

  :global(.timer-admin-form-close:hover) {
    color: var(--hud-text);
    border-color: var(--hud-text-muted);
  }

  :global(.timer-admin-form) {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.25rem;
  }

  :global(.timer-admin-form input),
  :global(.timer-admin-form textarea),
  :global(.timer-admin-form select) {
    display: block;
    width: 100%;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--hud-border);
    background: rgb(0 0 0 / 30%);
    color: var(--hud-text);
    font-family: var(--hud-mono);
    font-size: 0.85rem;
  }

  :global(.timer-admin-form textarea) {
    resize: vertical;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  }

  :global(.timer-admin-form input::placeholder),
  :global(.timer-admin-form textarea::placeholder) {
    color: var(--hud-text-dimmer);
  }

  :global(.timer-admin-form input:focus),
  :global(.timer-admin-form textarea:focus),
  :global(.timer-admin-form select:focus) {
    outline: none;
    border-color: var(--hud-border-hover);
  }

  :global(.timer-admin-form-actions) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  :global(.timer-admin-form-actions button) {
    padding: 0.5rem 1.25rem;
    font-family: var(--hud-mono);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    cursor: pointer;
    white-space: nowrap;
  }

  :global(.timer-admin-form-actions button[type="submit"]) {
    border: 1px solid var(--hud-accent);
    background: rgb(255 60 30 / 12%);
    color: var(--hud-accent);
  }

  :global(.timer-admin-form-actions button[type="submit"]:hover) {
    background: rgb(255 60 30 / 22%);
  }

  :global(.timer-admin-form-actions button:disabled) {
    opacity: 0.6;
    cursor: not-allowed;
  }

  :global(.timer-admin-cancel) {
    border: 1px solid var(--hud-border-hover);
    background: transparent;
    color: var(--hud-text-dim);
  }

  :global(.timer-admin-error) {
    color: var(--hud-accent);
    font-size: 0.85rem;
  }

  /* Login gate. */
  :global(.timer-admin-login-wrap .file-explorer-admin-login) {
    border: 1px solid var(--hud-border);
    border-radius: 0;
    background: var(--hud-panel-bg);
    padding: 1.25rem;
    min-width: 20rem;
  }

  :global(.timer-admin-login-wrap .file-explorer-admin-login input) {
    border: 1px solid var(--hud-border);
    border-radius: 0;
    background: rgb(0 0 0 / 30%);
    color: var(--hud-text);
    font-family: var(--hud-mono);
  }

  :global(.timer-admin-login-wrap .file-explorer-admin-login input:focus) {
    outline: none;
    border-color: var(--hud-border-hover);
  }

  :global(.timer-admin-login-wrap .file-explorer-icon-button) {
    border: 1px solid var(--hud-accent);
    border-radius: 0;
    background: rgb(255 60 30 / 12%);
    color: var(--hud-accent);
    font-family: var(--hud-mono);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  :global(.timer-admin-login-wrap .file-explorer-icon-button:hover) {
    background: rgb(255 60 30 / 22%);
    border-color: var(--hud-accent);
    color: var(--hud-accent);
  }

  :global(.timer-admin-login-wrap .file-explorer-link-button) {
    color: var(--hud-text-dim);
    font-family: var(--hud-mono);
  }

  :global(.timer-admin-login-wrap .file-explorer-link-button:hover) {
    color: var(--hud-text);
  }

  :global(.timer-admin-login-wrap .file-explorer-admin-login-hint) {
    color: var(--hud-text-dim);
    font-family: var(--hud-mono);
  }

  :global(.timer-admin-login-wrap .file-explorer-error),
  :global(.timer-admin-login-wrap .file-explorer-admin-login-error) {
    color: var(--hud-accent);
    font-family: var(--hud-mono);
  }

  /* Personnel DB tab (PersonnelAdmin.tsx) -- "dbsa-" prefix (not "dbs-",
     which belongs to the public /dbs page's own styles) so the two never
     collide even though both render against the same --hud-* tokens. */
  :global(.dbsa-admin) {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  :global(.dbsa-error) {
    color: var(--hud-accent);
    font-size: 0.85rem;
  }

  :global(.dbsa-empty),
  :global(.dbsa-loading) {
    color: var(--hud-text-muted);
    font-family: var(--hud-mono);
    font-size: 0.85rem;
  }

  :global(.dbsa-roster) {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
    gap: 0.75rem;
  }

  :global(.dbsa-roster-item) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
    background: var(--hud-panel-bg);
    border: 1px solid var(--hud-border);
    color: inherit;
    font: inherit;
    text-align: left;
    padding: 0.85rem 1rem;
    cursor: pointer;
  }

  :global(.dbsa-roster-item:hover) {
    border-color: var(--hud-accent);
  }

  :global(.dbsa-roster-name) {
    flex: 1 1 100%;
    color: var(--hud-text);
    font-family: var(--hud-mono);
    font-weight: 700;
    font-size: 0.9rem;
  }

  :global(.dbsa-roster-uid) {
    color: var(--hud-text-dimmer);
    font-family: var(--hud-mono);
    font-size: 0.68rem;
  }

  :global(.dbsa-add) {
    align-self: flex-start;
    padding: 0.7rem 1.5rem;
    border: 1px dashed var(--hud-border-hover);
    background: transparent;
    color: var(--hud-text-muted);
    font-family: var(--hud-mono);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-size: 0.75rem;
    cursor: pointer;
  }

  :global(.dbsa-add:hover) {
    border-color: var(--hud-text-muted);
    color: var(--hud-text);
  }

  :global(.dbsa-form-panel) {
    border: 1px solid var(--hud-border);
    background: var(--hud-panel-bg);
  }

  :global(.dbsa-form-header) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.85rem 1.1rem;
    border-bottom: 1px solid var(--hud-border);
  }

  :global(.dbsa-form-title) {
    font-family: var(--hud-mono);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--hud-text-dim);
  }

  :global(.dbsa-form-close) {
    border: 1px solid var(--hud-border-hover);
    background: transparent;
    color: var(--hud-text-muted);
    width: 1.6rem;
    height: 1.6rem;
    line-height: 1;
    font-size: 1.1rem;
    cursor: pointer;
  }

  :global(.dbsa-form-close:hover) {
    color: var(--hud-text);
    border-color: var(--hud-text-muted);
  }

  :global(.dbsa-form) {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding: 1.25rem;
  }

  :global(.dbsa-form input),
  :global(.dbsa-form select) {
    display: block;
    width: 100%;
    padding: 0.5rem 0.7rem;
    border: 1px solid var(--hud-border);
    background: rgb(0 0 0 / 30%);
    color: var(--hud-text);
    font-family: var(--hud-mono);
    font-size: 0.82rem;
    margin-top: 0.3rem;
  }

  :global(.dbsa-form input:focus),
  :global(.dbsa-form select:focus) {
    outline: none;
    border-color: var(--hud-border-hover);
  }

  :global(.dbsa-form input:disabled) {
    opacity: 0.6;
  }

  :global(.dbsa-form label) {
    display: flex;
    flex-direction: column;
    color: var(--hud-text-dim);
    font-family: var(--hud-mono);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  :global(.dbsa-top-fields) {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: 1rem;
  }

  :global(.dbsa-body) {
    display: grid;
    grid-template-columns: 13rem 1fr;
    border: 1px solid var(--hud-border);
  }

  @media (max-width: 40rem) {
    :global(.dbsa-body) {
      grid-template-columns: 1fr;
    }
  }

  :global(.dbsa-catnav) {
    border-right: 1px solid var(--hud-border);
    padding-block: 0.4rem;
    display: flex;
    flex-direction: column;
    max-height: 28rem;
    overflow-y: auto;
  }

  :global(.dbsa-catnav-item) {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: transparent;
    border: none;
    border-left: 2px solid transparent;
    color: var(--hud-text-muted);
    font: inherit;
    text-align: left;
    padding: 0.45rem 0.85rem;
    cursor: pointer;
  }

  :global(.dbsa-catnav-item:hover) {
    background: rgb(255 255 255 / 4%);
  }

  :global(.dbsa-catnav-item.is-active) {
    background: rgb(255 255 255 / 5%);
    border-left-color: var(--hud-accent);
    color: var(--hud-text);
  }

  :global(.dbsa-catnav-num) {
    font-family: var(--hud-mono);
    font-size: 0.62rem;
    color: var(--hud-text-dimmer);
    width: 1.1rem;
    flex-shrink: 0;
  }

  :global(.dbsa-catnav-name) {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.05em;
  }

  :global(.dbsa-catbody) {
    padding: 1rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-height: 28rem;
    overflow-y: auto;
  }

  :global(.dbsa-field) {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  :global(.dbsa-field-label) {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--hud-text-dim);
    font-family: var(--hud-mono);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  :global(.dbsa-field-sensitive-tag) {
    color: var(--hud-accent);
    font-size: 0.58rem;
    border: 1px solid rgb(255 60 30 / 45%);
    padding: 0 0.35rem;
  }

  :global(.dbsa-field input) {
    margin-top: 0;
  }

  /* Remove-entirely button for a per-profile custom field (built-in fields
     can only be blanked, so they never show this) -- pushed to the end of
     the label row via margin-left: auto. */
  :global(.dbsa-field-remove) {
    margin-left: auto;
    border: 1px solid var(--hud-border-hover);
    background: transparent;
    color: var(--hud-text-muted);
    width: 1.1rem;
    height: 1.1rem;
    line-height: 1;
    font-size: 0.75rem;
    text-transform: none;
    letter-spacing: normal;
    cursor: pointer;
  }

  :global(.dbsa-field-remove:hover) {
    color: var(--hud-accent);
    border-color: var(--hud-accent);
  }

  :global(.dbsa-addfield-trigger) {
    align-self: flex-start;
    margin-top: 0.5rem;
    padding: 0.4rem 0.9rem;
    border: 1px dashed var(--hud-border-hover);
    background: transparent;
    color: var(--hud-text-muted);
    font-family: var(--hud-mono);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 0.68rem;
    cursor: pointer;
  }

  :global(.dbsa-addfield-trigger:hover) {
    border-color: var(--hud-text-muted);
    color: var(--hud-text);
  }

  :global(.dbsa-addfield-form) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.5rem;
    padding: 0.6rem;
    background: rgb(0 0 0 / 25%);
    border: 1px solid var(--hud-border);
  }

  :global(.dbsa-addfield-form input[type="text"]) {
    margin-top: 0;
    width: auto;
    flex: 1;
    min-width: 8rem;
    font-size: 0.72rem;
    padding: 0.35rem 0.5rem;
  }

  :global(.dbsa-addfield-toggle) {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 0.3rem;
    color: var(--hud-text-muted);
    font-family: var(--hud-mono);
    font-size: 0.68rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    white-space: nowrap;
  }

  :global(.dbsa-addfield-form > button) {
    border: 1px solid var(--hud-ready-border);
    background: var(--hud-ready-bg);
    color: var(--hud-ready);
    font-family: var(--hud-mono);
    font-size: 0.68rem;
    font-weight: 700;
    padding: 0.35rem 0.75rem;
    cursor: pointer;
  }

  :global(.dbsa-addfield-form > button:hover) {
    background: rgb(143 209 138 / 18%);
  }

  :global(.dbsa-addfield-form > button.dbsa-cancel) {
    border: 1px solid var(--hud-border-hover) !important;
    background: transparent !important;
    color: var(--hud-text-dim) !important;
  }

  :global(.dbsa-assets) {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    margin-top: 0.2rem;
    padding: 0.5rem;
    background: rgb(0 0 0 / 25%);
    border: 1px solid var(--hud-border);
  }

  :global(.dbsa-asset-row) {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  :global(.dbsa-asset-kind) {
    color: var(--hud-ready);
    font-family: var(--hud-mono);
    font-size: 0.6rem;
    font-weight: 700;
    border: 1px solid var(--hud-ready-border);
    padding: 0.05rem 0.35rem;
    flex-shrink: 0;
  }

  :global(.dbsa-asset-label) {
    flex: 1;
    font-size: 0.75rem;
    color: var(--hud-text);
  }

  :global(.dbsa-asset-meta) {
    color: var(--hud-text-dimmer);
    font-family: var(--hud-mono);
    font-size: 0.65rem;
  }

  :global(.dbsa-asset-remove) {
    border: 1px solid var(--hud-border-hover);
    background: transparent;
    color: var(--hud-text-muted);
    width: 1.2rem;
    height: 1.2rem;
    line-height: 1;
    font-size: 0.85rem;
    cursor: pointer;
    flex-shrink: 0;
